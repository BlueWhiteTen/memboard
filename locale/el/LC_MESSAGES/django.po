msgstr "Ο πίνακας «%(board)s» δημιουργήθηκε!"

#: core/views.py:504 core/views.py:1317 core/views.py:1571 core/views.py:1623
msgid "You're not a member of that board."
msgstr "Δεν είστε μέλος αυτού του πίνακα."

#: core/views.py:707
#, python-format
msgid "%(actor)s updated the board cover"
msgstr "Ο/Η %(actor)s ενημέρωσε το εξώφυλλο του πίνακα"

#: core/views.py:865
msgid "Board settings updated."
msgstr "Οι ρυθμίσεις του πίνακα ενημερώθηκαν."

#: core/views.py:952 core/views.py:1024 core/views.py:1047
#, python-format
msgid "%(actor)s invited you to join \"%(board)s\""
msgstr "Ο/Η %(actor)s σας προσκάλεσε στο «%(board)s»"

#: core/views.py:969 core/views.py:1938
#, python-format
msgid "%(actor)s sent you a friend request"
msgstr "Ο/Η %(actor)s σας έστειλε αίτημα φιλίας"

#: core/views.py:1067 core/views.py:1167
#, python-format
msgid "%(actor)s joined the board"
msgstr "Ο/Η %(actor)s συμμετέχει πλέον στον πίνακα"

#: core/views.py:1068
#, python-format
msgid "You've joined \"%(board)s\"!"
msgstr "Συμμετέχετε πλέον στο «%(board)s»!"

#: core/views.py:1123
msgid "You don't have permission to delete this board."
msgstr "Δεν έχετε δικαίωμα να διαγράψετε αυτόν τον πίνακα."

#: core/views.py:1128
#, python-format
msgid "Board \"%(board)s\" deleted."
msgstr "Ο πίνακας «%(board)s» διαγράφηκε."

#: core/views.py:1139
msgid "You don't have permission to request to join that board."
msgstr "Δεν έχετε δικαίωμα να ζητήσετε συμμετοχή σε αυτόν τον πίνακα."

#: core/views.py:1145
#, python-format
msgid "%(actor)s asked to join \"%(board)s\""
msgstr "Ο/Η %(actor)s ζήτησε να συμμετάσχει στο «%(board)s»"

#: core/views.py:1150
#, python-format
msgid "Request sent — %(owner)s will need to approve it."
msgstr "Το αίτημα στάλθηκε — ο/η %(owner)s θα χρειαστεί να το εγκρίνει."

#: core/views.py:1170
#, python-format
msgid "%(actor)s approved your request to join \"%(board)s\""
msgstr "Ο/Η %(actor)s ενέκρινε το αίτημά σας συμμετοχής στο «%(board)s»"

#: core/views.py:1175
#, python-format
msgid "%(name)s added to the board!"
msgstr "Ο/Η %(name)s προστέθηκε στον πίνακα!"

#: core/views.py:1203
#, python-format
msgid "%(actor)s made you an admin of \"%(board)s\""
msgstr "Ο/Η %(actor)s σάς έκανε διαχειριστή του «%(board)s»"

#: core/views.py:1235
#, python-format
msgid "\"%(name)s\" created — add friends to it below."
msgstr "Το «%(name)s» δημιουργήθηκε — προσθέστε φίλους παρακάτω."

#: core/views.py:1284
#, python-format
msgid "\"%(name)s\" updated."
msgstr "Το «%(name)s» ενημερώθηκε."

#: core/views.py:1307
#, python-format
msgid "\"%(name)s\" deleted."
msgstr "Το «%(name)s» διαγράφηκε."

#: core/views.py:1333
#, python-format
msgid "%(actor)s tagged you in a memory on \"%(board)s\""
msgstr "Ο/Η %(actor)s σας επισήμανε σε μια ανάμνηση στο «%(board)s»"

#: core/views.py:1339
#, python-format
msgid "%(actor)s added a memory: %(summary)s"
msgstr "Ο/Η %(actor)s πρόσθεσε μια ανάμνηση: %(summary)s"

#: core/views.py:1344
msgid "Memory saved!"
msgstr "Η ανάμνηση αποθηκεύτηκε!"

#: core/views.py:1371
msgid "You don't have permission to edit that memory."
msgstr "Δεν έχετε δικαίωμα να επεξεργαστείτε αυτή την ανάμνηση."

#: core/views.py:1383
#, python-format
msgid "%(actor)s edited a memory: %(summary)s"
msgstr "Ο/Η %(actor)s επεξεργάστηκε μια ανάμνηση: %(summary)s"

#: core/views.py:1388
msgid "Memory updated!"
msgstr "Η ανάμνηση ενημερώθηκε!"

#: core/views.py:1401
msgid "You don't have permission to delete that memory."
msgstr "Δεν έχετε δικαίωμα να διαγράψετε αυτή την ανάμνηση."

#: core/views.py:1405
#, python-format
msgid "%(actor)s deleted a memory: %(summary)s"
msgstr "Ο/Η %(actor)s διέγραψε μια ανάμνηση: %(summary)s"

#: core/views.py:1412
msgid "Memory moved to the recycle bin — it'll be kept for 30 days."
msgstr ""
"Η ανάμνηση μετακινήθηκε στον κάδο ανακύκλωσης — θα διατηρηθεί για 30 ημέρες."

#: core/views.py:1425
msgid "You don't have permission to restore that memory."
msgstr "Δεν έχετε δικαίωμα να επαναφέρετε αυτή την ανάμνηση."

#: core/views.py:1432
#, python-format
msgid "%(actor)s restored a memory from the recycle bin"
msgstr "Ο/Η %(actor)s επανέφερε μια ανάμνηση από τον κάδο ανακύκλωσης"

#: core/views.py:1435
msgid "Memory restored!"
msgstr "Η ανάμνηση επαναφέρθηκε!"

#: core/views.py:1461
#, python-format
msgid "%(actor)s deleted %(count)d memory at once"
msgid_plural "%(actor)s deleted %(count)d memories at once"
msgstr[0] "Ο/Η %(actor)s διέγραψε %(count)d ανάμνηση ταυτόχρονα"
msgstr[1] "Ο/Η %(actor)s διέγραψε %(count)d αναμνήσεις ταυτόχρονα"

#: core/views.py:1545
#, python-format
msgid "%(actor)s copied a memory here from \"%(board)s\""
msgstr "Ο/Η %(actor)s αντέγραψε εδώ μια ανάμνηση από «%(board)s»"

#: core/views.py:1621
msgid ""
"Board owners can't leave — delete the board instead, or transfer ownership "
"first."
msgstr ""
"Οι ιδιοκτήτες πίνακα δεν μπορούν να αποχωρήσουν — διαγράψτε τον πίνακα ή "
"μεταβιβάστε πρώτα την ιδιοκτησία."

#: core/views.py:1627
#, python-format
msgid "%(actor)s left the board"
msgstr "Ο/Η %(actor)s αποχώρησε από τον πίνακα"

#: core/views.py:1628
#, python-format
msgid "You left \"%(board)s\"."
msgstr "Αποχωρήσατε από το «%(board)s»."

#: core/views.py:1643
#, python-format
msgid "%(actor)s pinned a memory"
msgstr "Ο/Η %(actor)s καρφίτσωσε μια ανάμνηση"

#: core/views.py:1645
#, python-format
msgid "%(actor)s unpinned a memory"
msgstr "Ο/Η %(actor)s ξεκαρφίτσωσε μια ανάμνηση"

#: core/views.py:1649
#, python-format
msgid "%(actor)s pinned your memory in \"%(board)s\""
msgstr "Ο/Η %(actor)s καρφίτσωσε την ανάμνησή σας στο «%(board)s»"

#: core/views.py:1714
#, python-format
msgid "%(actor)s reacted %(emoji)s to your memory in \"%(board)s\""
msgstr ""
"Ο/Η %(actor)s αντέδρασε με %(emoji)s στην ανάμνησή σας στο «%(board)s»"

#: core/views.py:1720
#, python-format
msgid "%(actor)s reacted %(emoji)s to a memory"
msgstr "Ο/Η %(actor)s αντέδρασε με %(emoji)s σε μια ανάμνηση"

#: core/views.py:1746
#, python-format
msgid "%(actor)s commented on a memory"
msgstr "Ο/Η %(actor)s σχολίασε μια ανάμνηση"

#: core/views.py:1751
#, python-format
msgid "%(actor)s commented on your memory in \"%(board)s\""
msgstr "Ο/Η %(actor)s σχολίασε την ανάμνησή σας στο «%(board)s»"

#: core/views.py:1940
#, python-format
msgid "Friend request sent to %(name)s!"
msgstr "Το αίτημα φιλίας στάλθηκε στον/στην %(name)s!"

#: core/views.py:1948
#, python-format
msgid ""
"%(email)s isn't on WorthKeeping yet — we've emailed them an invite. You'll "
"be friends automatically once they sign up."
msgstr ""
"Ο/Η %(email)s δεν είναι ακόμα στο WorthKeeping — του/της στείλαμε πρόσκληση "
"με email. Θα γίνετε φίλοι αυτόματα μόλις εγγραφεί."

#: core/views.py:1953
#, python-format
msgid "Failed to send email: %(err)s"
msgstr "Αποτυχία αποστολής email: %(err)s"

#: core/views.py:1968
#, python-format
msgid "You're now friends with %(name)s!"
msgstr "Είστε πλέον φίλοι με τον/την %(name)s!"

#: core/views.py:2002
msgid "You don't share a board or friendship with that person."
msgstr "Δεν μοιράζεστε πίνακα ή φιλία με αυτό το άτομο."

#: core/views.py:2038
msgid "Profile updated."
msgstr "Το προφίλ ενημερώθηκε."

#: core/views.py:2085
msgid ""
"Your account is paused. Log back in any time to pick up right where you left"
" off."
msgstr ""
"Ο λογαριασμός σας είναι σε παύση. Συνδεθείτε ξανά όποτε θέλετε για να "
"συνεχίσετε ακριβώς από εκεί που μείνατε."

#: core/views.py:2102
msgid "That didn't match your account email — nothing was deleted."
msgstr ""
"Αυτό δεν ταίριαξε με το email του λογαριασμού σας — δεν διαγράφηκε τίποτα."

#: core/views.py:2138
msgid "Your account has been deleted."
msgstr "Ο λογαριασμός σας διαγράφηκε."
